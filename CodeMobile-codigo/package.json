{
  "name": "code-mobile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Code Mobile — editor de código mobile-first com a experiência do VS Code",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/downlevel.mjs && node scripts/css-compat.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^7.26.4",
    "@luau-rs/luau": "^0.739.0",
    "fflate": "^0.8.2",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.83.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-legacy": "^2.1.0"
  }
}

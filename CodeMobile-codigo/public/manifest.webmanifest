{
  "name": "Code Mobile",
  "short_name": "Code",
  "description": "Editor de código mobile com explorer, abas, busca, terminal e paleta de comandos.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "any",
  "background_color": "#1e1e1e",
